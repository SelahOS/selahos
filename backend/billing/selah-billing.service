[Unit]
Description=SelahBridgePro billing (Stripe Checkout + webhook)
After=network.target

[Service]
Type=simple
User=dane
WorkingDirectory=/home/dane/apps/selah-billing
EnvironmentFile=/home/dane/apps/selah-billing/.env
ExecStart=/home/dane/apps/selah-billing/venv/bin/python3 /home/dane/apps/selah-billing/app.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/dane/apps/selah-billing

[Install]
WantedBy=multi-user.target
